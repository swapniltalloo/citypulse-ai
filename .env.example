# ==============================================================================
# CityPulse AI - Environment Configuration
# ==============================================================================

# Groq Cloud API Key (Get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenWeatherMap API Key (Free tier at https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Tavily AI Search API Key (Free 1000 searches/mo at https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Model Selection (Defaults to 'openai/gpt-oss-120b', or 'openai/gpt-oss-20b')
DEFAULT_MODEL=openai/gpt-oss-120b

# Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=false
